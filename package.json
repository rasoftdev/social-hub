{
  "name": "social-hub",
  "version": "1.0.0",
  "description": "Social Hub - multi-account wrapper for WhatsApp, Facebook, Messenger, Instagram, TikTok and LinkedIn",
  "main": "src/main/main.js",
  "author": {
    "name": "Ricardo Alvarez",
    "email": "dev@ricardoalvarez.co",
    "url": "https://me.ricardoalvarez.co"
  },
  "homepage": "https://me.ricardoalvarez.co",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "icons": "node scripts/make-icons.js"
  },
  "build": {
    "appId": "com.rasoftdev.socialhub",
    "productName": "Social Hub",
    "copyright": "Copyright © 2026 RASOFTDEV",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "Social_Hub_${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "lucide-static": "^1.80.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5"
  }
}
